    {
      "id": "8-GlVMQagZiWsNZsUKfE_",
      "type": "text",
      "x": 87.54264831542969,
      "y": 179.75,
      "width": 294.9147033691406,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
