      "seed": 1439752726,
      "version": 3,
      "versionNonce": 920544150,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793971030562,
      "link": null,
      "locked": false,
      "text": "Why Direct Docker & Nested runsc Fail:\n1. modprobe -> /lib/modules/4.4.0 missing\n2. iptables-nft -> netlink EINVAL\n3. overlay2 on gofer rootfs -> EINVAL\n4. nested mount(proc/cgroup) -> EPERM\n5. nested NEW_LISTENER -> EBUSY",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_list",
      "originalText": "Why Direct Docker & Nested runsc Fail:\n1. modprobe -> /lib/modules/4.4.0 missing\n2. iptables-nft -> netlink EINVAL\n3. overlay2 on gofer rootfs -> EINVAL\n4. nested mount(proc/cgroup) -> EPERM\n5. nested NEW_LISTENER -> EBUSY",
      "autoResize": true,
      "lineHeight": 1.25
    },
