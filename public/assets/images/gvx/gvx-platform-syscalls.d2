direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 20
  }
}

grid-columns: 1
vertical-gap: 24

whpx: "1. Windows Hardware Engine: platform/whpx (WinHvPlatform.dll)" {
  style.fill: "#eff6ff"
  style.stroke: "#1d4ed8"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 10

  w_mmu: "4 KB Paging over 64 KB Windows Granularity\nMaps 64 MiB pgalloc.MemoryFile arenas once via\nWHvMapGpaRange; guest page tables enforce 4 KB R/W/X"
  w_trap_x86: "amd64 Trap Path (stubgen_x86.go)\nGuest Ring-3 SYSCALL -> Ring-0 MSR_LSTAR ->\nspills GPRs to 4 KB CommPage -> HLT exits vCPU"
  w_trap_arm: "arm64 Trap Path (stubgen_a64.go)\nGuest EL0 SVC #0 -> EL1 vectors -> spills X0..X8\nto CommPage -> unbacked GPA-0 load exits to Sentry"
  w_ret: "Resume Path\nGo Sentry writes return registers to CommPage ->\nresumes vCPU -> Ring-0 / EL1 reloads -> SYSRETQ / ERET"
}

hvf: "2. macOS Hardware Engine: platform/hvf (Hypervisor.framework)" {
  style.fill: "#f0fdf4"
  style.stroke: "#15803d"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 10

  h_mmu: "Two-Stage MMU (4 KB Guest over 16 KB XNU Host)\nStage-2 (hv_vm_map) maps 1 GiB chunks at 16 KB;\nStage-1 (TTBR0_EL1, TG0=4KB) enforces 4 KB R-X / RW-"
  h_trap: "Trap Path (bluepill_arm64.go)\nGuest EL0 SVC #0 or Page Fault -> EL1 VBAR_EL1 ->\nspills X0..X8, SP_EL0, ELR_EL1 to 4 KB CommPage -> HVC #0"
  h_ret: "Resume Path\nhv_vcpu_run returns to locked Go thread -> Sentry\nservices syscall -> updates CommPage -> ERET to EL0"
}

winsystrap: "3. Windows User-Mode Fallback: platform/systrap (winsystrap)" {
  style.fill: "#fefce8"
  style.stroke: "#b45309"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 10

  ws_iso: "Hardware CR3 / TTBR0 Isolation\nRuns guest code in isolated 1 KB stub subprocesses\n(stubimage_xplat.go) under Low-Integrity Token + JobObject"
  ws_patch: "In-Place Binary Patcher\nReplaces 2-byte syscall (0f 05) with jmp rel32 (or CC 90)\non amd64, and svc #0 with B island jump (or brk) on arm64"
  ws_ipc: "Fast-Path Shared Memory IPC\nIsland spills registers to winSysmsg page -> syncs via\nWaitOnAddress / WakeByAddressSingle (DebugObject on fault)"
}

linsystrap: "4. Linux User-Mode Engine: platform/systrap (Native & Nested)" {
  style.fill: "#f3e8ff"
  style.stroke: "#6d28d9"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 10

  ls_fast: "Guest Thread Fast Path (sysmsg)\nGuest syscalls trap via SECCOMP_RET_TRAP (SIGSYS) ->\nbinary-patches site with jmp rel32 to sysmsg + SYS_FUTEX"
  ls_notif: "Stub syscallThread (_RUN_SECCOMP_LOOP = 6)\nAddress-space syscalls (mmap/munmap/clone) wake stub\nvia SECCOMP_RET_USER_NOTIF listener FD"
  ls_nested: "Nested Fallback Mode (_RUN_SYSCALL_LOOP = 5, PR #71)\nWhen outer sandbox holds NEW_LISTENER (EBUSY), stub\nsyscallThread switches to shared-memory SYS_FUTEX loop"
}

whpx -> hvf -> winsystrap -> linsystrap: "All 4 backends implement platform.Context"
