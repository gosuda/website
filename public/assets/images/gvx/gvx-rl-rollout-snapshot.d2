direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 20
  }
}

grid-columns: 1
vertical-gap: 24

stage1: "Stage 1: One-Time Golden State Build (Per Dataset)" {
  style.fill: "#f3e8ff"
  style.stroke: "#6d28d9"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 8

  g_erofs: "1. Shared Read-Only OCI Layer Cache\n~/.cache/gvx/layers/<sha256>.gvx-erofs-v3-b4096.erofs\nshared across all workers via OS page cache"
  g_ext4: "2. Golden Docker Volume (golden-docker.ext4)\nSeeded once via --mount type=volume,src=golden-docker.ext4,\ndst=/var/lib/docker with base images pre-pulled"
}

stage2: "Stage 2: Per-Episode Instant Reset (~100 ms CoW Clone)" {
  style.fill: "#fefce8"
  style.stroke: "#b45309"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 8

  c_reflink: "1. Reflink Clone\ncp --reflink=always golden-docker.ext4 ep-0042.ext4\n(XFS, Btrfs, ZFS, or APFS shares 4 KiB extents with 0 copy)"
  c_quota: "2. Exclusive Volume Lock & Resource Guard\next4lite locks ep-0042.ext4 (flock) and grows in 16 MiB\nsteps; -m 4g --cpus 2 enforces memory and CPU budgets"
}

stage3: "Stage 3: Parallel Unprivileged Rollout Execution" {
  style.fill: "#f0fdf4"
  style.stroke: "#15803d"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 8

  w1: "Episode #1 (rungv / pkg/gvx)\nMounts ep-0001.ext4 -> /var/lib/docker\nIsolated netstack (10.0.2.15/24, zero xtables lock)"
  w2: "Episode #2 (rungv / pkg/gvx)\nMounts ep-0002.ext4 -> /var/lib/docker\nIsolated netstack (10.0.2.15/24, zero xtables lock)"
  wn: "Episode #N (rungv / pkg/gvx)\nMounts ep-N.ext4 -> /var/lib/docker\nRuns docker build, compose up, and pytest without root"
}

stage4: "Stage 4: Zero-Residue Episode Teardown (~10 ms)" {
  style.fill: "#eff6ff"
  style.stroke: "#1d4ed8"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 8

  t_close: "1. Terminate Process\nsb.Close() (Go SDK) or kill rungv PID releases\nall virtual mounts, sockets, and processes"
  t_unlink: "2. Reclaim Dirty Extents\nrm -f ep-0042.ext4 (0 leaked host cgroups,\nmount points, loop devices, or iptables rules)"
}

stage1 -> stage2: "env.reset() clones golden-docker.ext4"
stage2 -> stage3: "Boot isolated unprivileged gvx sandbox"
stage3 -> stage4: "Reward computed; env.close()"
