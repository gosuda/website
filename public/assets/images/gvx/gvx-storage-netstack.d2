direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 20
  }
}

grid-columns: 1
vertical-gap: 24

vfs: "VFS2 Virtual Filesystem Subsystem (pkg/sentry/vfs)" {
  style.fill: "#f0fdf4"
  style.stroke: "#15803d"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 10

  erofs: "1. Rootfs Lower Layers (fsimpl/erofs + overlay)\nMounts pre-compiled <sha256>.erofs images under\ntmpfs upper layer; 0 host openat calls at runtime;\nshared OS page cache across concurrent instances"
  ext4lite: "2. Persistent Volumes (fsimpl/ext4lite)\nPure-Go ext4 inside 1 pre-opened <name>.ext4 file;\n4 KiB blocks, 16 MiB groups, JBD2 ordered journal,\n0:0 whiteouts, trusted.overlay.* xattrs, RENAME_EXCHANGE\n(0 Windows Defender WdFilter.sys per-file scans)"
  hostfs: "3. Host Workspace Mounts (fsimpl/hostfs v2)\nScoped *os.Root handle + O_NOFOLLOW walk +\n.gvx_meta CRC-32C journal (UID/GID/mode/xattr/symlinks)\n+ NameCodec (~gvx~%XX case-folding escape) +\nkqueue / ReadDirectoryChangesW -> guest inotify bridge"
}

net: "Dual-Track User-Space Network Stack (pkg/tcpip + pkg/netbackend)" {
  style.fill: "#eff6ff"
  style.stroke: "#1d4ed8"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 10

  guest_net: "1. In-Guest Linux Network Stack (pkg/tcpip)\nVirtual eth0 (10.0.2.15/24, MTU 1500), loopback,\ndocker0 bridge, veth, vxlan, wireguard netlink,\nand iptables-legacy (nat, filter, raw, conntrack,\naddrtype, statistic, recent, ipset)"
  track_a: "2. Track A (-net=nat, Default)\nL4 Go net NAT forwarder (10.0.2.2 gateway) +\nbuilt-in DNS relay (10.0.2.3) + -p port forwarder\n(TCP/UDP & unix:~/.gvx/docker.sock:2375) ->\nunprivileged host dial/listen"
  track_b: "3. Track B (-net=wg, Cryptographic L3 Mesh)\nL3 channel.Endpoint -> in-process wireguard-go\nengine -> 1 pre-opened host UDP socket\n(zero kernel TUN/TAP or WinTun drivers)"
}

vfs -> net: "Both subsystems run in-process inside Go Sentry"
