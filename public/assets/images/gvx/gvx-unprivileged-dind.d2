direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 20
  }
}

grid-columns: 1
vertical-gap: 24

failures: "1. Why Standard Rootless Tools Fail (uid=1000, no_new_privs=1)" {
  style.fill: "#fef2f2"
  style.stroke: "#b91c1c"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 8

  f1: "1. Host Docker CLI -> unix:///var/run/docker.sock:\nENOENT (no host daemon running)"
  f2: "2. sudo / newuidmap / fusermount3:\nBlocked by PR_SET_NO_NEW_PRIVS=1 (EPERM)"
  f3: "3. Rootless Docker / Podman / bwrap:\nunshare(CLONE_NEWUSER) blocked by seccomp/sysctl (EPERM)"
  f4: "4. Nested runc / crun:\nmount(proc) & mount(cgroup) blocked without CAP_SYS_ADMIN"
  f5: "5. fuse-overlayfs:\nopen(/dev/fuse) fails with ENOENT"
}

gvx_flow: "2. How rungv Runs docker:dind in One Unprivileged Process" {
  style.fill: "#f0fdf4"
  style.stroke: "#15803d"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 8

  step1: "1. Host Docker CLI (docker context use gvx)\nConnects to unix://\$HOME/.gvx/docker.sock (mode 0600)"
  step2: "2. pkg/netbackend Port Forwarder\n-p unix:~/.gvx/docker.sock:2375 relays to guest 127.0.0.1:2375"
  step3: "3. Guest dockerd + containerd + runc\nRun with virtual UID 0 & virtual CAP_SYS_ADMIN in Sentry"
  step4: "4. Virtual Mounts & Cgroups v2\nmount(proc, sysfs, tmpfs, cgroup2) & pivot_root\nexecute in Sentry VFS2 memory (0 host mount calls)"
  step5: "5. Native overlayfs on ext4lite\n-v gvx-docker:/var/lib/docker stores layers in\n1 host file (gvx-docker.ext4) with 0:0 whiteouts,\ntrusted.overlay.* xattrs, d_type, and RENAME_EXCHANGE"
  step6: "6. User-Space Container Networking\ndocker0 bridge, veth pairs, and iptables-legacy\nNAT chains run inside Sentry netstack"
}

host_reqs: "3. Minimal Host Linux Syscalls Required by rungv" {
  style.fill: "#f3e8ff"
  style.stroke: "#6d28d9"
  style.stroke-width: 2
  style.border-radius: 8
  grid-columns: 1
  vertical-gap: 8

  r1: "1. ptrace(PTRACE_ATTACH) on self-child stub once at init\n(permitted under default yama.ptrace_scope <= 1)"
  r2: "2. seccomp(SECCOMP_SET_MODE_FILTER)\nfor stub syscall interception"
  r3: "3. mmap(..., PROT_EXEC, ...)\nfor guest ELF segments and sysmsg trampoline"
}

failures -> gvx_flow: "Bypass host namespace and mount checks via Sentry"
gvx_flow -> host_reqs: "Uses only unprivileged host primitives"
