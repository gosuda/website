package home

import (
	"gosuda.org/website/view/ui"
	"strconv"
)

templ Posts(posts []*PostPreview) {
	<section id="posts" class="mx-auto max-w-6xl scroll-mt-20 px-4 pt-24">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">From the blog</h2>
		<p class="mt-3 text-muted-foreground">Deep dives written by GoSuda members.</p>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			for _, p := range posts[:min(9, len(posts))] {
				@PostCard(p)
			}
		</div>
		if len(posts) > 9 {
			<details class="group/more">
				<summary class="mx-auto mt-10 flex h-11 w-fit cursor-pointer list-none items-center gap-2 rounded-md border bg-background/60 px-5 text-sm font-bold backdrop-blur transition-all hover:bg-accent hover:text-accent-foreground group-open/more:hidden [&::-webkit-details-marker]:hidden">
					Show { strconv.Itoa(len(posts) - 9) } more posts
				</summary>
				<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					for _, p := range posts[9:] {
						@PostCard(p)
					}
				</div>
			</details>
		}
	</section>
}

templ PostCard(p *PostPreview) {
	@ui.LinkCard(p.URL, nil) {
		<div class="aspect-[16/9] overflow-hidden bg-muted">
			<img src={ p.Cover } alt="" loading="lazy" decoding="async" width="1200" height="675" class="cover size-full object-cover"/>
		</div>
		<div class="relative z-10 flex flex-1 flex-col p-5">
			<h3 class="line-clamp-2 text-lg font-bold leading-snug transition-colors group-hover:text-primary">{ p.Title }</h3>
			<p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground">{ p.Description }</p>
			<div class="mt-5 flex items-center justify-between gap-3 text-xs text-muted-foreground">
				<span class="truncate"><span class="font-bold text-foreground">{ p.Author }</span> · { p.Date.Format("Jan 2, 2006") }</span>
				<span class="flex shrink-0 gap-3">
					<span data-summary-view-count data-summary-url={ templ.SafeURL("https://gosuda.org" + p.Path) } aria-label="View count">views ...</span>
					<span data-summary-like-count data-summary-url={ templ.SafeURL("https://gosuda.org" + p.Path) } aria-label="Like count">likes ...</span>
				</span>
			</div>
		</div>
	}
}
