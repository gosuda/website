package view

import (
	"gosuda.org/website/internal/types"
	"gosuda.org/website/view/layout"
	"gosuda.org/website/view/post"
)

templ PostPage(m *layout.Metadata, doc *types.Document, cover string) {
	<!DOCTYPE html>
	<html lang={ m.Language }>
		@layout.Head(m)
		<body>
			@layout.Header(m)
			<main>
				@post.Article(doc, "https://gosuda.org"+doc.Metadata.Path, cover)
			</main>
			@layout.Footer()
		</body>
	</html>
}
