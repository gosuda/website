package post

import (
	"gosuda.org/website/internal/types"
	"time"
)

templ Article(doc *types.Document, canonical string, cover string) {
	<article class="mx-auto max-w-3xl px-4 pt-10">
		<header class="mb-10">
			<h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{ doc.Metadata.Title }</h1>
			<div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
				<span>By <span class="font-bold text-foreground">{ doc.Metadata.Author }</span></span>
				<time datetime={ doc.Metadata.Date.Format(time.RFC3339) }>{ doc.Metadata.Date.Format("January 2, 2006") }</time>
				<!-- Placeholder: will hydrate on client to actual view count -->
				<span data-view-count data-url={ templ.SafeURL(canonical) } aria-label="View count">views ...</span>
				<!-- Placeholder like button: inner span will hydrate with like count -->
				<button type="button" data-like-button data-url={ templ.SafeURL(canonical) } class="rounded-full border px-3 py-1 transition-all hover:-translate-y-0.5 hover:border-primary hover:text-primary active:scale-95" aria-label="Like this post">
					♥ <span data-like-count>likes ...</span>
				</button>
			</div>
			<div class="mt-8 aspect-[16/9] overflow-hidden rounded-xl border bg-muted">
				<img src={ cover } alt="" width="1200" height="675" class="size-full object-cover"/>
			</div>
		</header>
		<div class="prose max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:underline-offset-4 prose-img:rounded-lg">
			@templ.Raw(doc.HTML)
		</div>
	</article>
}
